# Copy to .env (gitignored). Never paste real values into chat, issues, or commits.

# ── Super Market (Predictions Cup) ──
SUSQ_API_KEY=
SUSQ_BASE_URL=https://www.thesuper.market/api/v1
SUSQ_TOURNAMENT_SLUG=midterm-elections
# paper | live   (live ALSO requires ops/GO_LIVE containing the words "go live")
SUSQ_MODE=paper

# ── Cloudflare (dashboard, cron Worker, R2 backups) ──
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
SUSQ_KV_NAMESPACE_ID=
SUSQ_R2_BUCKET=susquatch-backups
SUSQ_R2_ACCESS_KEY_ID=
SUSQ_R2_SECRET_ACCESS_KEY=
# shared secret the server uses to push status to the dashboard
SUSQ_STATUS_PUSH_TOKEN=

# ── Reports repo (aggregated packets only; never raw Competition Data) ──
SUSQ_REPORTS_REPO=KarthikSubramanian07/susquatch-reports
