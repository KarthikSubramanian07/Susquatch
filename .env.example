# Copy to .env (gitignored). Never paste real values into chat, issues, or commits.

# ── Super Market (Predictions Cup) ──
SUSQ_API_KEY=
SUSQ_BASE_URL=https://www.thesuper.market/api/v1
SUSQ_TOURNAMENT_SLUG=midterm-elections
# paper | live   (live ALSO requires ops/GO_LIVE containing the words "go live")
SUSQ_MODE=paper

# ── Cloudflare (dashboard, cron Worker) ──
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
SUSQ_KV_NAMESPACE_ID=
# shared secret the server uses to push status to the dashboard
SUSQ_STATUS_PUSH_TOKEN=

# ── Reports repo (aggregated packets only; never raw Competition Data) ──
SUSQ_REPORTS_REPO=KarthikSubramanian07/susquatch-reports

# ── Ops (docs/OPS.md) ──
# Which optional services `make up` starts: bridge (Oct 1), rust (after cutover), election (Nov 3-4).
# nats, the research scheduler and the ops helpers always run.
COMPOSE_PROFILES=bridge
# rust-live extra flags: set to --election on Nov 3-4 (results pollers inside rust-live; see docs/RUNBOOK.md)
SUSQ_LIVE_FLAGS=
# rust-live subcommand: paper-run for the pre-cutover paper run (own lease/intents/status, alongside the bridge),
# run (the default) once rust-live is the trader.
SUSQ_LIVE_CMD=run
SUSQ_DASHBOARD_URL=https://susquatch.pages.dev
# Backups: any S3 bucket. The SUSQ_R2_* names are history; today it is a private Backblaze B2 bucket
# (10 GB free, no card) with an application key restricted to it. Leave the endpoint empty to fall back to
# Cloudflare R2 at https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com (needs a card, so not used).
# B2: SUSQ_R2_ENDPOINT=https://s3.<region>.backblazeb2.com  SUSQ_R2_PROVIDER=Other
SUSQ_R2_BUCKET=susquatch-backups
SUSQ_R2_ACCESS_KEY_ID=
SUSQ_R2_SECRET_ACCESS_KEY=
SUSQ_R2_ENDPOINT=
SUSQ_R2_PROVIDER=
# Expiry dates of credentials that expire (YYYY-MM-DD); the daily self-check warns 14 days ahead.
SUSQ_EXPIRES_SUPERMARKET_KEY=
SUSQ_EXPIRES_GITHUB_TOKEN=
SUSQ_EXPIRES_CLOUDFLARE_TOKEN=
SUSQ_EXPIRES_R2_KEY=
# Optional read-only tokens for `make costs` (Plan:read on GitHub; Billing:read on Cloudflare)
SUSQ_GITHUB_BILLING_TOKEN=
SUSQ_CF_BILLING_TOKEN=
# Election-night throttling of the co-tenant (we can't edit its repo; see ops/priority.sh)
SUSQ_COTENANT_PROJECT=calshi
SUSQ_COTENANT_THROTTLE="backfill|research|batch|scheduler"
SUSQ_COTENANT_UNITS=
# Set by ops/install.sh: container user/group = owner of the checkout; docker socket group for the watchdog proxy
SUSQ_UID=
SUSQ_GID=
DOCKER_GID=
