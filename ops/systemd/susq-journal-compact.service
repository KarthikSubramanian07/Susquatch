[Unit]
Description=Compress bridge journal days older than yesterday (lossless zstd)

[Service]
Type=oneshot
User=@SUSQ_USER@
Environment=SUSQ_HOME=@SUSQ_HOME@
ExecStart=@SUSQ_HOME@/ops/journal-compact.sh
# Never compete with the trading path.
Nice=19
CPUWeight=20
IOSchedulingClass=idle
TimeoutStartSec=2h
