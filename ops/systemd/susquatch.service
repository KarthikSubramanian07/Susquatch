# Installed by ops/install.sh (@SUSQ_HOME@ / @SUSQ_USER@ substituted). Wraps the compose stack.
# Per-container restarts are Compose's job (restart: unless-stopped) and the watchdog's (unhealthy);
# this unit brings the stack up at boot and re-applies election-night priority if we boot inside the window.
[Unit]
Description=Susquatch stack (docker compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=@SUSQ_USER@
WorkingDirectory=@SUSQ_HOME@
Environment=SUSQ_HOME=@SUSQ_HOME@
ExecStart=/usr/bin/docker compose --project-directory @SUSQ_HOME@ -f @SUSQ_HOME@/ops/compose.yaml up -d --no-build --remove-orphans
ExecStartPost=+@SUSQ_HOME@/ops/priority.sh auto
ExecStop=/usr/bin/docker compose --project-directory @SUSQ_HOME@ -f @SUSQ_HOME@/ops/compose.yaml down
# Never build here: a native image build on 4 GB starved the live trader on 2026-10-05 (available memory fell to
# ~50 MB, sshd and the Azure agent stopped answering). ops/install.sh builds explicitly before enabling the unit.
TimeoutStartSec=10min
TimeoutStopSec=2min

[Install]
WantedBy=multi-user.target
