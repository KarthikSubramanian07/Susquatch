# Archives the CA Secretary of State test-window feeds so we have real replay data before Nov 3.
# Runs enr-capture inside the rust-live image; results land in data/enr/ (gitignored, backed up to R2).
[Unit]
Description=Susquatch: capture a CA SoS election-night test window
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@SUSQ_USER@
WorkingDirectory=@SUSQ_HOME@
Environment=SUSQ_HOME=@SUSQ_HOME@
# 5.5 h covers the Wednesday 8:00-12:00 PT window and the Saturday one (whose text says until 13:00 PT).
ExecStart=/usr/bin/docker compose --project-directory @SUSQ_HOME@ -f @SUSQ_HOME@/ops/compose.yaml --profile rust \
  run --rm --no-deps --entrypoint enr-capture rust-live \
  --config config/enr_sources.toml --out data/enr --source ca_sos --source ca_sos_api --duration-s 19800
Nice=10
CPUWeight=50
TimeoutStartSec=6h
